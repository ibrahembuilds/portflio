# Systems Teardown — server configuration
#
# Copy to .env.local for local work, and set the same names in the Vercel
# project (Settings → Environment Variables) for production.
#
# Nothing here is prefixed VITE_, which is what keeps every value below out of
# the browser bundle. Never add a VITE_ prefix to a secret.
#
# The application degrades rather than breaks when a value is missing:
#   no database        → the lead is still reported by email, and logged
#   no model provider  → a deterministic report is generated from the answers
#   no email provider  → the report still displays and downloads
#   no booking URL     → "Booking link coming soon" plus the contact address


# ── Database (Vercel Postgres) ───────────────────────────────────────────────
# Vercel sets POSTGRES_URL automatically once a Postgres store is attached to
# the project. DATABASE_URL is accepted as an alias.
# Apply db/migrations/0001_systems_teardown.sql before the first real lead.
POSTGRES_URL=


# ── Language model (OpenRouter, or any OpenAI-compatible endpoint) ───────────
OPENROUTER_API_KEY=
# Required. There is no default: shipping a guessed model id fails in a way
# that is hard to notice. Unset means every report uses the deterministic path.
# Pick an id from https://openrouter.ai/models, e.g. openai/gpt-4o-mini
TEARDOWN_LLM_MODEL=
# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TEARDOWN_LLM_TIMEOUT_MS=20000
TEARDOWN_LLM_MAX_TOKENS=2600


# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
TEARDOWN_FROM_EMAIL=Ibrahem Ahmed <reports@ibrahemahmed.com>
# Where new-lead notifications go. Defaults to hello@ibrahemahmed.com.
TEARDOWN_NOTIFY_EMAIL=


# ── Booking ──────────────────────────────────────────────────────────────────
# The 20-minute Systems Teardown booking page. Left unset until it exists —
# the report shows "Booking link coming soon" rather than inventing a URL.
SYSTEMS_TEARDOWN_BOOKING_URL=


# ── Bot protection (Cloudflare Turnstile, optional) ──────────────────────────
# Both must be set for the check to run. Unset means rate limiting and
# server-side validation are the only protection.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=


# ── Private lead view ────────────────────────────────────────────────────────
# A long random string. Unset disables /admin entirely (the API returns 503).
# Generate one with:  openssl rand -base64 36
TEARDOWN_ADMIN_TOKEN=


# ── Rate limits (requests per client per hour) ───────────────────────────────
TEARDOWN_RATE_LIMIT_SUBMIT=5
TEARDOWN_RATE_LIMIT_WEBSITE=12
TEARDOWN_RATE_LIMIT_EVENT=200


# ── URLs used in emails and report links ─────────────────────────────────────
TEARDOWN_PUBLIC_SITE_URL=https://ibrahemahmed.com
TEARDOWN_PUBLIC_AUDIT_URL=https://audit.ibrahemahmed.com
